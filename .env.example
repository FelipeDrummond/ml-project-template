# MLflow tracking — local file store by default. Override on cloud to a server URI.
MLFLOW_TRACKING_URI=file:./mlruns

# Set on cloud to a hosted MLflow server, e.g.:
# MLFLOW_TRACKING_URI=http://mlflow.internal:5000

# Optional: Weights & Biases (only if you swap trackers later)
# WANDB_API_KEY=
# WANDB_PROJECT=

# Cloud GPU host — used by `make cloud-setup` / `make cloud-train` / `make pull-results`.
# REMOTE=user@cloudbox
# REMOTE_DIR=/workspace/<project>

# CUDA index URL pinned to torch's CUDA 12.1 wheels (used when installing with --extra cuda).
# Override only if you need a different CUDA build.
PYTORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu121
